# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used for OAuth redirects). Leave empty locally.
NEXT_PUBLIC_SITE_URL=
# Time zone for calendars and "this month" usage
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo

# Google Calendar (Google Cloud Console → Credentials → OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored refresh tokens.
GOOGLE_TOKEN_KEY=

# Shared secret for the Vercel Cron route (Vercel sends it as a Bearer token)
CRON_SECRET=

# Show the AI Simulator and Live Class preview screens (mock data only)
FEATURE_AI_LABS=false
